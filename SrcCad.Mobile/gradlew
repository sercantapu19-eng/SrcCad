#!/bin/sh
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$APP_HOME/gradle/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/gradle-wrapper.jar"
WRAPPER_B64="$WRAPPER_DIR/gradle-wrapper.jar.b64"

if [ ! -f "$WRAPPER_JAR" ]; then
    if [ ! -f "$WRAPPER_B64" ]; then
        echo "[ERROR] Gradle wrapper payload is missing." >&2
        exit 1
    fi
    base64 -d "$WRAPPER_B64" > "$WRAPPER_JAR" || exit 1
fi

if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
else
    JAVA_EXE="java"
fi

exec "$JAVA_EXE" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
