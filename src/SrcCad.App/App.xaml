<Application x:Class="SrcCad.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DrawingImage x:Key="CadTrimIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 2,25 L 28,3 M 3,3 L 28,26 M 14,4 L 14,28 M 22,4 L 22,28"><GeometryDrawing.Pen><Pen Brush="#C74B36" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadSelectIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#1976B8" Geometry="M 3,2 L 3,24 9,18 14,28 18,26 13,16 22,16 Z"/></DrawingImage.Drawing></DrawingImage>
        <Style TargetType="Button" x:Key="CommandButton">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#BFC9D2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Original SrcCad vector drawings; no external icon assets. -->
        <DrawingImage x:Key="CadLineIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 5,27 L 27,5 M 3,25 L 7,25 7,29 3,29 Z M 25,3 L 29,3 29,7 25,7 Z"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadCenterlineIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 3,27 L 10,20 M 13,17 L 17,13 M 20,10 L 29,1 M 4,12 L 4,20 M 0,16 L 8,16"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadRectangleIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 3,6 L 29,6 29,26 3,26 Z M 1,4 L 5,4 5,8 1,8 Z"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadCircleIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 28,16 A 12,12 0 1 1 4,16 A 12,12 0 1 1 28,16 M 11,16 L 21,16 M 16,11 L 16,21"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadDimensionIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 3,3 L 3,28 M 29,3 L 29,28 M 3,10 L 29,10 M 3,10 L 8,7 M 3,10 L 8,13 M 29,10 L 24,7 M 29,10 L 24,13 M 10,23 L 22,23"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadRelationIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 3,10 L 29,10 M 3,22 L 29,22 M 10,3 L 10,29"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadExitSketchIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 4,5 L 18,5 18,27 4,27 Z M 13,16 L 30,16 M 24,10 L 30,16 24,22"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadCutIcon"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Geometry="M 3,10 L 13,3 29,3 29,22 19,29 3,29 Z M 3,10 L 19,10 29,3 M 19,10 L 19,29"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.6"/></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#C44738" Geometry="M 8,13 L 15,13 15,24 8,24 Z M 9,7 L 14,7 14,17 17,17 11.5,22 6,17 9,17 Z"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadExtrudeIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 4,11 L 20,11 20,28 4,28 Z M 4,11 L 12,3 28,3 28,20 20,28 M 20,11 L 28,3"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="CadSketchIcon"><DrawingImage.Drawing><GeometryDrawing Geometry="M 3,27 L 24,27 29,6 8,6 Z M 10,22 L 23,9 M 20,8 L 25,13"><GeometryDrawing.Pen><Pen Brush="#236FA3" Thickness="1.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
        <Style x:Key="CadCommandButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Foreground" Value="#17212B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="30" Height="30" Margin="0,0,0,4"
                           Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               MaxWidth="92" MinHeight="28" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#687786"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="#F1F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="HeadButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#C9D3DC"/>
        </Style>
    </Application.Resources>
</Application>

