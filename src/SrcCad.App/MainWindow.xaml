<Window x:Class="SrcCad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="SrcCad — Parametrik CAD"
        Width="1450" Height="900"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#EAF1F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- SrcCad identity; no third-party trademark/icon usage -->
        <Border Grid.Row="0" Background="#1D2731">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/SrcCadLogo.png" Width="44" Height="44" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SrcCad" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Parametrik CAD • OCCT B-Rep" FontSize="11" Foreground="#B8C6D2"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" Background="#263541" CornerRadius="12" Padding="12,4">
                    <TextBlock Text="PART DESIGN • ALPHA" Foreground="#DDE8F0" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Menu Grid.Row="1" Background="#FBFCFD" BorderBrush="#CDD5DC" BorderThickness="0,0,0,1">
            <MenuItem Header="Dosya">
                <MenuItem Header="Yeni Parça" InputGestureText="Ctrl+N" Click="NewPart_Click"/>
                <MenuItem Header="Aç…" InputGestureText="Ctrl+O" Click="OpenPart_Click"/>
                <MenuItem Header="Farklı Kaydet…" InputGestureText="Ctrl+S" Click="SavePart_Click"/>
                <Separator/>
                <MenuItem Header="Çıkış" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Düzenle" IsEnabled="False"/>
            <MenuItem Header="Görünüm" IsEnabled="False"/>
            <MenuItem Header="Araçlar" IsEnabled="False"/>
            <MenuItem Header="Yardım" IsEnabled="False"/>
        </Menu>

        <TabControl Grid.Row="2" x:Name="CommandTabs" Background="#F5F7F9" BorderBrush="#C8D1D9">
            <TabItem Header="UNSURLAR" x:Name="FeaturesTab">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="Çizim" Click="StartSketch_Click" x:Name="StartSketchButton" ToolTip="Düzlem veya düzlemsel yüz seçin; Çizim yeni sketch'i doğrudan o destek üzerinde açar."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Ekstrüzyon" Click="Extrude_Click" x:Name="ExtrudeButton" IsEnabled="False"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="Yeni Çizim" Click="NewProfileSketch_Click" x:Name="NewProfileSketchButton" IsEnabled="False" Visibility="Collapsed"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Ekstrüzyon Kes" Click="Cut_Click" x:Name="CutButton" IsEnabled="False" ToolTip="Bir yüz/düzlemde Çizim oluşturun; çizimden çıkınca bu komut seçili profili katıdan keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Döndürme" Click="Revolve_Click" x:Name="RevolveButton" ToolTip="Kapalı profil + tek merkez çizgisi ekseni ile gerçek OCCT döndürme oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Döndürerek Kes" Click="RevolveCut_Click" x:Name="RevolveCutButton" ToolTip="Kapalı profil + tek merkez çizgisi ekseni ile mevcut katıdan döndürerek keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Süpürme" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Loft" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Radyus" Click="Fillet_Click" x:Name="FilletButton" ToolTip="Kenarları seçin; gerçek OCCT 3B radyus oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Pah" Click="Chamfer_Click" x:Name="ChamferButton" ToolTip="Kenarları seçin; gerçek OCCT 3B pah oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Delik" Click="Hole_Click" x:Name="HoleButton" ToolTip="Düzlemsel yüz seçin; tıklanan konumda gerçek parametrik delik oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kabuk" Click="Shell_Click" x:Name="ShellButton" ToolTip="Açılacak yüzleri seçin; kalınlıkla gerçek içi boş katı oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Draft" Click="Draft_Click" x:Name="DraftButton" ToolTip="Seçili yüzlere, aktif referans düzlemine göre gerçek parametrik draft açısı uygular."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Nervür" Click="Rib_Click" x:Name="RibButton" ToolTip="Katıdan sonra oluşturulan açık çizgi sketch'ini kalınlaştırıp gerçek B-Rep nervür olarak birleştirir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="LinearPattern_Click" x:Name="LinearPatternButton" ToolTip="Seçili düzlem/yüzün X yönünde parametrik gövde dizilimi oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="CircularPattern_Click" x:Name="CircularPatternButton" ToolTip="Seçili düzlem/yüzün normal ekseni etrafında parametrik gövde dizilimi oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Aynala" Click="Mirror_Click" x:Name="MirrorButton" ToolTip="Düzlemsel yüz veya Ön/Üst/Sağ Düzlem seçin; katıyı gerçek 3B ayna dönüşümüyle çoğaltır."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Referans Geometri" Click="CadCommandPlaceholder_Click"/>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CommandButton}" Content="Yeni Parça" Click="NewPart_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="ÇİZİM" x:Name="SketchTab">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Seç (Esc)" Tag="{StaticResource CadSelectIcon}" Click="SelectTool_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizgi ▾" Tag="{StaticResource CadLineIcon}" Click="CommandFamily_Click" x:Name="LineButton">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Çizgi" Click="Line_Click"/>
                            <MenuItem Header="Merkez Çizgisi" Click="Centerline_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dikdörtgen ▾" Tag="{StaticResource CadRectangleIcon}" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Köşe Dikdörtgen" Click="CornerRectangle_Click"/>
                            <MenuItem Header="Merkez Dikdörtgen" Click="CenterRectangle_Click"/>
                            <MenuItem Header="3 Noktalı Köşe Dikdörtgen" Click="ThreePointRectangle_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Daire ▾" Tag="{StaticResource CadCircleIcon}" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Merkez-Yarıçap Dairesi" Click="Circle_Click"/>
                            <MenuItem Header="3 Nokta Dairesi" Click="ThreePointCircle_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Yay" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Slot" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çokgen" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Elips" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizim Radyusu" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizim Pahı" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizgi Kırp" Tag="{StaticResource CadTrimIcon}" Click="Trim_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Uzat" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Ofset" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Aynala" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Akıllı Ölçü" Click="SmartDimension_Click" x:Name="SmartDimensionButton"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadRelationIcon}" Content="İlişkiler" Click="ShowSketchRelations_Click"/>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExitSketchIcon}" Content="Çizimden Çık" Click="ExitSketch_Click" x:Name="ExitSketchButton"/>
                    <Button x:Name="CancelSourceSketchEditButton" Style="{StaticResource CommandButton}" Content="Düzenlemeyi&#x0a;İptal Et" Click="CancelSourceSketchEdit_Click" Visibility="Collapsed"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="SAC LEVHA">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Taban Flanş" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Kenar Flanşı" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Gönye Flanşı" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Sac Kes" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Hem" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Jog" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizilmiş Büküm" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Açınım" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Katla" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Yırtık" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Köşe Rölyefi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Sac'a Dönüştür" Click="CadCommandPlaceholder_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="PROFİLLER">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="3B Çizim" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Yapısal Eleman" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadTrimIcon}" Content="Kırp / Uzat" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Köşebent" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Uç Kapağı" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kaynak Dikişi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesim Listesi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Profil Kütüphanesi" Click="CadCommandPlaceholder_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="MONTAJ">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Bileşen Ekle" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Montaj İlişkisi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Bileşen Aynala" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Patlatılmış Görünüm" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çakışma Kontrolü" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Hareket" Click="CadCommandPlaceholder_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="TEKNİK RESİM">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Model Görünümü" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="İzdüşüm" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesit" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Detay" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kopuk Görünüm" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Akıllı Ölçü" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Delik Çağrısı" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Merkez İşareti" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Not" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Malzeme Listesi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Balon" Click="CadCommandPlaceholder_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="ÖLÇÜM / İNCELEME">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Ölç" Click="InspectMeasure_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kütle Özellikleri" Click="InspectMassProperties_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesit Görünümü" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Geometri Kontrolü" Click="InspectGeometry_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Draft Analizi" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çakışma" Click="CadCommandPlaceholder_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Karşılaştır" Click="CadCommandPlaceholder_Click"/>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="ManagerTabs" BorderBrush="#BAC5CE" Background="#F8FAFB">
                <TabItem Header="FeatureManager" x:Name="FeatureManagerTab">
                    <TreeView x:Name="FeatureTree" BorderThickness="0" Background="#FAFBFC"
                              SelectedItemChanged="FeatureTree_SelectedItemChanged" MouseDoubleClick="FeatureTree_MouseDoubleClick">
                        <TreeViewItem Header="Parça1" x:Name="PartNode" IsExpanded="True">
                            <TreeViewItem Header="Geçmiş"/>
                            <TreeViewItem Header="Sensörler"/>
                            <TreeViewItem Header="Detaylandırmalar"/>
                            <TreeViewItem Header="Malzeme &lt;belirli değil&gt;"/>
                            <TreeViewItem Header="Orijin" x:Name="OriginNode" IsExpanded="True">
                                <TreeViewItem Header="Ön Düzlem" Tag="plane:front" x:Name="FrontPlaneNode"/>
                                <TreeViewItem Header="Üst Düzlem" Tag="plane:top" x:Name="TopPlaneNode"/>
                                <TreeViewItem Header="Sağ Düzlem" Tag="plane:right" x:Name="RightPlaneNode"/>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                </TabItem>
                <TabItem Header="PropertyManager" x:Name="PropertyManagerTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock x:Name="PropertyTitle" Text="Özellikler" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="PropertyInfo" Text="Düzlem seçin ve Çizim komutunu başlatın." TextWrapping="Wrap" Foreground="#52606B"/>

                            <StackPanel x:Name="SketchPropertyPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Çizim Durumu" FontWeight="Bold"/>
                                <TextBlock x:Name="SketchDefinitionText" Text="Eksik Tanımlı" Margin="0,4,0,10"/>
                                <TextBlock Text="Seçili Objeler" FontWeight="Bold"/>
                                <TextBlock x:Name="SketchSelectionText" Text="Seçim yok" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                <TextBlock Text="İlişkiler Ekle" FontWeight="Bold" Margin="0,4,0,6"/>
                                <WrapPanel>
                                    <Button Content="Yatay" Margin="0,0,4,4" Click="HorizontalRelation_Click"/>
                                    <Button Content="Dikey" Margin="0,0,4,4" Click="VerticalRelation_Click"/>
                                    <Button Content="Çakışık" Margin="0,0,4,4" Click="CoincidentRelation_Click"/>
                                    <Button Content="Paralel" Margin="0,0,4,4" Click="ParallelRelation_Click"/>
                                    <Button Content="Dik" Margin="0,0,4,4" Click="PerpendicularRelation_Click"/>
                                    <Button Content="Eşit" Margin="0,0,4,4" Click="EqualRelation_Click"/>
                                    <Button Content="Eşdoğrusal" Margin="0,0,4,4" Click="CollinearRelation_Click"/>
                                    <Button Content="Eşmerkezli" Margin="0,0,4,4" Click="ConcentricRelation_Click"/>
                                    <Button Content="Orta Nokta" Click="MidpointRelation_Click" Margin="2" Padding="6,3"/>
                                    <Button Content="Teğet" Click="TangentRelation_Click" Margin="2" Padding="6,3"/>
                                    <Button Content="Sabitle" Margin="0,0,4,4" Click="FixRelation_Click"/>
                                </WrapPanel>

                                <TextBlock Text="Var Olan İlişkiler" FontWeight="Bold" Margin="0,8,0,4"/>
                                <ListBox x:Name="SketchRelationsList" Height="100"/>
                                <Button Content="Seçili İlişkiyi Sil" Margin="0,4,0,0" Click="DeleteRelation_Click"/>

                                <TextBlock Text="Ölçüler" FontWeight="Bold" Margin="0,10,0,4"/>
                                <ListBox x:Name="SketchDimensionsList" Height="110" MouseDoubleClick="SketchDimensionsList_MouseDoubleClick"/>
                                <Button Content="Seçili Ölçüyü Düzenle" Margin="0,4,0,0" Click="EditSelectedDimension_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="GraphFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Derinlik (mm)"/>
                                <TextBox x:Name="GraphDepth" TextChanged="GraphParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="GraphThroughAll" Content="Tümünden Geç" Checked="GraphParameterChanged" Unchecked="GraphParameterChanged"/>
                                <CheckBox x:Name="GraphReverse" Content="Yönü Ters Çevir" Checked="GraphParameterChanged" Unchecked="GraphParameterChanged" Margin="0,8"/>
                                <TextBlock x:Name="GraphFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="GraphFeatureOk_Click" x:Name="GraphAcceptButton"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="GraphFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="EdgeFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="EdgeFeatureValueLabel" Text="Değer (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="EdgeFeatureValue" TextChanged="EdgeFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Seçili Kenarlar" FontWeight="Bold"/>
                                <TextBlock x:Name="EdgeFeatureSelectionText" Text="Kenar seçilmedi" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Ctrl ile çoklu kenar seçebilirsiniz. Seçim değiştikçe gerçek B-Rep önizleme yeniden oluşturulur." TextWrapping="Wrap" Foreground="#5F6B76" Margin="0,0,0,8"/>
                                <TextBlock x:Name="EdgeFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="EdgeFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="EdgeFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="HoleFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Delik Çapı (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="HoleDiameter" TextChanged="HoleFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Derinlik (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="HoleDepth" TextChanged="HoleFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="HoleThroughAll" Content="Tümünden Geç" Checked="HoleFeatureParameterChanged" Unchecked="HoleFeatureParameterChanged" Margin="0,0,0,8"/>
                                <CheckBox x:Name="HoleReverse" Content="Yönü Ters Çevir" Checked="HoleFeatureParameterChanged" Unchecked="HoleFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Konum / Destek" FontWeight="Bold"/>
                                <TextBlock x:Name="HoleSelectionText" Text="Düzlemsel yüz seçin ve konumu tıklayın." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="HoleFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="HoleFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="HoleFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RevolveFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Döndürme Açısı (°)" FontWeight="Bold"/>
                                <TextBox x:Name="RevolveAngle" TextChanged="RevolveFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="RevolveReverse" Content="Yönü Ters Çevir" Checked="RevolveFeatureParameterChanged" Unchecked="RevolveFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Eksen" FontWeight="Bold"/>
                                <TextBlock x:Name="RevolveAxisText" Text="Çizimde tek bir Merkez Çizgisi gerekir." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="RevolveFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="RevolveFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="RevolveFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ShellFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Kabuk Kalınlığı (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="ShellThickness" TextChanged="ShellFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="ShellOutward" Content="Dışa Doğru Kalınlaştır" Checked="ShellFeatureParameterChanged" Unchecked="ShellFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Açılacak Yüzler" FontWeight="Bold"/>
                                <TextBlock x:Name="ShellSelectionText" Text="En az bir yüz seçin." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Ctrl ile birden fazla yüz seçebilirsiniz." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ShellFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="ShellFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="ShellFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="DraftFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Draft Açısı (°)" FontWeight="Bold"/>
                                <TextBox x:Name="DraftAngle" TextChanged="DraftFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="DraftReverse" Content="Açıyı Ters Çevir" Checked="DraftFeatureParameterChanged" Unchecked="DraftFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Nötr Düzlem" FontWeight="Bold"/>
                                <TextBlock x:Name="DraftNeutralPlaneText" Text="Aktif düzlem" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Draft Uygulanacak Yüzler" FontWeight="Bold"/>
                                <TextBlock x:Name="DraftSelectionText" Text="En az bir yüz seçin." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Ctrl ile çoklu yüz seçebilirsiniz. Nötr düzlem, komut başlatılırken aktif olan Ön/Üst/Sağ düzlemdir." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DraftFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="DraftFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="DraftFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RibFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Nervür Kalınlığı (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="RibThickness" TextChanged="RibFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Yükseklik / Derinlik (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="RibDepth" TextChanged="RibFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="RibReverse" Content="Yönü Ters Çevir" Checked="RibFeatureParameterChanged" Unchecked="RibFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Kaynak Çizim" FontWeight="Bold"/>
                                <TextBlock x:Name="RibSketchText" Text="Açık çizgi sketch'i seçilmedi." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Sketch en az bir normal (construction olmayan) çizgi içermeli ve nervür taban katıya temas etmelidir." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RibFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="RibFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="RibFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="MirrorFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Ayna Düzlemi" FontWeight="Bold"/>
                                <TextBlock x:Name="MirrorPlaneText" Text="Düzlem seçilmedi" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <CheckBox x:Name="MirrorKeepOriginal" Content="Orijinal Gövdeyi Koru" Checked="MirrorFeatureParameterChanged" Unchecked="MirrorFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MirrorFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="MirrorFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="MirrorFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PatternFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="PatternFeatureTitle" Text="Dizilim" FontWeight="Bold"/>
                                <TextBlock Text="Adet" Margin="0,6,0,0"/>
                                <TextBox x:Name="PatternCount" TextChanged="PatternFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock x:Name="PatternValueLabel" Text="Aralık (mm)"/>
                                <TextBox x:Name="PatternValue" TextChanged="PatternFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Referans Yön / Eksen" FontWeight="Bold"/>
                                <TextBlock x:Name="PatternReferenceText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="PatternFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="PatternFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="PatternFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ExtrudePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Ekstrüzyon" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Derinlik (mm)"/>
                                <TextBox x:Name="ExtrudeDepthTextBox" Text="20" Margin="0,4,0,4" TextChanged="ExtrudeDepth_TextChanged"/>
                                <TextBlock Text="Mouse tekeri: ±10 mm" Foreground="#5F6B76" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✓" FontSize="18" Width="52" Height="34" Margin="0,0,8,0" Click="ExtrudeOk_Click" x:Name="ExtrudeAcceptButton"/>
                                    <Button Content="✕" FontSize="18" Width="52" Height="34" Click="ExtrudeCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#C7D0D8"/>

            <Grid Grid.Column="2" Background="#E9F1F7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F9FBFC" BorderBrush="#C8D2DA" BorderThickness="0,0,0,1">
                    <DockPanel Margin="8,2">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Style="{StaticResource HeadButton}" Content="Fit" Click="Fit_Click" ToolTip="Ekrana Sığdır (F)"/>
                            <Button Style="{StaticResource HeadButton}" Content="Dik Bak" Click="NormalTo_Click" ToolTip="Seçili düzlemsel yüze/düzleme dik bak (Ctrl+8)"/>
                            <Button Style="{StaticResource HeadButton}" Content="ISO" Click="Iso_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Ön" Click="Front_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Üst" Click="Top_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Sağ" Click="Right_Click"/>
                            <Separator Margin="6,4"/>
                            <TextBlock Text="Görünüm:" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <Button Style="{StaticResource HeadButton}" Content="Gölge+Kenar" Click="ShadedEdges_Click" ToolTip="Katı gölgelendirme + kenarlar"/>
                            <Button Style="{StaticResource HeadButton}" Content="Gölge" Click="Shaded_Click" ToolTip="Yalnız gölgeli yüzey"/>
                            <Button Style="{StaticResource HeadButton}" Content="Tel" Click="Wireframe_Click" ToolTip="Tel kafes"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Seçim:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <Button Style="{StaticResource HeadButton}" Content="Yüz" Click="FaceSelection_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Kenar" Click="EdgeSelection_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Köşe" Click="VertexSelection_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#EAF2F8">
                    <wfi:WindowsFormsHost x:Name="ViewportHost"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="#F9FBFC" BorderBrush="#C7D0D8" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="SrcCad hazır" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="mm" VerticalAlignment="Center" Foreground="#51606C"/>
            </Grid>
        </Border>
    </Grid>
</Window>

