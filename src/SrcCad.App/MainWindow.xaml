                                <TextBlock Text="Ctrl ile birden fazla yüz seçebilirsiniz." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ShellFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="ShellFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="ShellFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="DraftFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Draft Açısı (°)" FontWeight="Bold"/>
                                <TextBox x:Name="DraftAngle" TextChanged="DraftFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="DraftReverse" Content="Açıyı Ters Çevir" Checked="DraftFeatureParameterChanged" Unchecked="DraftFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Nötr Düzlem" FontWeight="Bold"/>
                                <TextBlock x:Name="DraftNeutralPlaneText" Text="Aktif düzlem" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Draft Uygulanacak Yüzler" FontWeight="Bold"/>
                                <TextBlock x:Name="DraftSelectionText" Text="En az bir yüz seçin." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Ctrl ile çoklu yüz seçebilirsiniz. Nötr düzlem, komut başlatılırken aktif olan Ön/Üst/Sağ düzlemdir." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DraftFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="DraftFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="DraftFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RibFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Nervür Kalınlığı (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="RibThickness" TextChanged="RibFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Yükseklik / Derinlik (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="RibDepth" TextChanged="RibFeatureParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="RibReverse" Content="Yönü Ters Çevir" Checked="RibFeatureParameterChanged" Unchecked="RibFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Kaynak Çizim" FontWeight="Bold"/>
                                <TextBlock x:Name="RibSketchText" Text="Açık çizgi sketch'i seçilmedi." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Sketch en az bir normal (construction olmayan) çizgi içermeli ve nervür taban katıya temas etmelidir." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RibFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="RibFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="RibFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ReferenceGeometryPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="ReferenceGeometryTypeText" Text="Referans Geometri" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel x:Name="ReferencePlaneEditor" Visibility="Collapsed">
                                    <TextBlock Text="Taban Düzlem"/>
                                    <TextBlock x:Name="ReferencePlaneBaseText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <TextBlock Text="Ofset (mm)"/>
                                    <TextBox x:Name="ReferencePlaneOffset" TextChanged="ReferenceGeometryParameterChanged" Margin="0,4,0,8"/>
                                </StackPanel>
                                <StackPanel x:Name="ReferenceAxisEditor" Visibility="Collapsed">
                                    <TextBlock Text="Başlangıç Noktası X / Y / Z (mm)"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBox x:Name="ReferenceAxisX" Width="70" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferenceAxisY" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferenceAxisZ" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                    </StackPanel>
                                    <TextBlock Text="Yön X / Y / Z"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBox x:Name="ReferenceAxisDx" Width="70" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferenceAxisDy" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferenceAxisDz" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ReferencePointEditor" Visibility="Collapsed">
                                    <TextBlock Text="Nokta X / Y / Z (mm)"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBox x:Name="ReferencePointX" Width="70" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferencePointY" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                        <TextBox x:Name="ReferencePointZ" Width="70" Margin="4,0,0,0" TextChanged="ReferenceGeometryParameterChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="ReferenceGeometryError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="ReferenceGeometryOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="ReferenceGeometryCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="MirrorFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Ayna Düzlemi" FontWeight="Bold"/>
                                <TextBlock x:Name="MirrorPlaneText" Text="Düzlem seçilmedi" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <CheckBox x:Name="MirrorKeepOriginal" Content="Orijinal Gövdeyi Koru" Checked="MirrorFeatureParameterChanged" Unchecked="MirrorFeatureParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MirrorFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="MirrorFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="MirrorFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PatternFeaturePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="PatternFeatureTitle" Text="Dizilim" FontWeight="Bold"/>
                                <TextBlock Text="Adet" Margin="0,6,0,0"/>
                                <TextBox x:Name="PatternCount" TextChanged="PatternFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock x:Name="PatternValueLabel" Text="Aralık (mm)"/>
                                <TextBox x:Name="PatternValue" TextChanged="PatternFeatureParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Referans Yön / Eksen" FontWeight="Bold"/>
                                <TextBlock x:Name="PatternReferenceText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="PatternFeatureError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="PatternFeatureOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="PatternFeatureCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="EdgeFlangePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Kenar Flanşı" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="EdgeFlangeLengthLabel" Text="Flanş Uzunluğu (mm)"/>
                                <TextBox x:Name="EdgeFlangeLength" TextChanged="EdgeFlangeParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock x:Name="EdgeFlangeAngleLabel" Text="Açı (°)"/>
                                <TextBox x:Name="EdgeFlangeAngle" TextChanged="EdgeFlangeParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock x:Name="EdgeFlangeThicknessLabel" Text="Sac Kalınlığı (mm)"/>
                                <TextBox x:Name="EdgeFlangeThickness" TextChanged="EdgeFlangeParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock x:Name="EdgeFlangeBendRadiusLabel" Text="Büküm Yarıçapı (mm)"/>
                                <TextBox x:Name="EdgeFlangeBendRadius" TextChanged="EdgeFlangeParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="EdgeFlangeReverse" Content="Flanş Yönünü Ters Çevir" Checked="EdgeFlangeParameterChanged" Unchecked="EdgeFlangeParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Seçili Kenarlar" FontWeight="Bold"/>
                                <TextBlock x:Name="EdgeFlangeSelectionText" Text="Doğrusal sac kenarı seçin." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="Ctrl ile birden fazla kenar seçebilirsiniz. Geometri seçilen kenarın komşu sac yüzünden yönünü otomatik çıkarır." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="EdgeFlangeError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="EdgeFlangeOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="EdgeFlangeCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="EndCapPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Uç Kapağı Kalınlığı (mm)" FontWeight="Bold"/>
                                <TextBox x:Name="EndCapThickness" TextChanged="EndCapParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="EndCapReverse" Content="Yönü Ters Çevir" Checked="EndCapParameterChanged" Unchecked="EndCapParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Uç Yüzü" FontWeight="Bold"/>
                                <TextBlock x:Name="EndCapSelectionText" Text="Düzlemsel uç yüzü seçin." TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="EndCapError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="EndCapOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="EndCapCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SheetMetalConvertPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Sac'a Dönüştür" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Sac Kalınlığı (mm)"/>
                                <TextBox x:Name="ConvertSheetThickness" TextChanged="SheetMetalConvertParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Varsayılan Büküm Yarıçapı (mm)"/>
                                <TextBox x:Name="ConvertSheetBendRadius" TextChanged="SheetMetalConvertParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="K-Faktörü (0–1)"/>
                                <TextBox x:Name="ConvertSheetKFactor" TextChanged="SheetMetalConvertParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Bu feature katıyı yeniden örneklemez; mevcut B-Rep'i sac parametreleriyle işaretler ve sonraki sac işlemlerinin bağımlılık kökü olur." Foreground="#5F6B76" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SheetMetalConvertError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="SheetMetalConvertOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="SheetMetalConvertCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SheetMetalBasePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Taban Flanş" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Sac Kalınlığı (mm)"/>
                                <TextBox x:Name="SheetThickness" TextChanged="SheetMetalBaseParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="Varsayılan Büküm Yarıçapı (mm)"/>
                                <TextBox x:Name="SheetBendRadius" TextChanged="SheetMetalBaseParameterChanged" Margin="0,4,0,8"/>
                                <TextBlock Text="K-Faktörü (0–1)"/>
                                <TextBox x:Name="SheetKFactor" TextChanged="SheetMetalBaseParameterChanged" Margin="0,4,0,8"/>
                                <CheckBox x:Name="SheetReverse" Content="Kalınlık Yönünü Ters Çevir" Checked="SheetMetalBaseParameterChanged" Unchecked="SheetMetalBaseParameterChanged" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SheetMetalBaseInfo" TextWrapping="Wrap" Foreground="#5F6B76" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SheetMetalBaseError" Foreground="#AA2020" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓" Width="52" Height="34" Click="SheetMetalBaseOk_Click"/>
                                    <Button Content="✕" Width="52" Height="34" Margin="8,0,0,0" Click="SheetMetalBaseCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ExtrudePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Ekstrüzyon" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Derinlik (mm)"/>
                                <TextBox x:Name="ExtrudeDepthTextBox" Text="20" Margin="0,4,0,4" TextChanged="ExtrudeDepth_TextChanged"/>
                                <TextBlock Text="Mouse tekeri: ±10 mm" Foreground="#5F6B76" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✓" FontSize="18" Width="52" Height="34" Margin="0,0,8,0" Click="ExtrudeOk_Click" x:Name="ExtrudeAcceptButton"/>
                                    <Button Content="✕" FontSize="18" Width="52" Height="34" Click="ExtrudeCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#C7D0D8"/>

            <Grid Grid.Column="2" Background="#E9F1F7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F9FBFC" BorderBrush="#C8D2DA" BorderThickness="0,0,0,1">
                    <DockPanel Margin="8,2">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Style="{StaticResource HeadButton}" Content="Fit" Click="Fit_Click" ToolTip="Ekrana Sığdır (F)"/>
                            <Button Style="{StaticResource HeadButton}" Content="Dik Bak" Click="NormalTo_Click" ToolTip="Seçili düzlemsel yüze/düzleme dik bak (Ctrl+8)"/>
                            <Button Style="{StaticResource HeadButton}" Content="ISO" Click="Iso_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Ön" Click="Front_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Üst" Click="Top_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Sağ" Click="Right_Click"/>
                            <Separator Margin="6,4"/>
                            <TextBlock Text="Görünüm:" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <Button Style="{StaticResource HeadButton}" Content="Gölge+Kenar" Click="ShadedEdges_Click" ToolTip="Katı gölgelendirme + kenarlar"/>
                            <Button Style="{StaticResource HeadButton}" Content="Gölge" Click="Shaded_Click" ToolTip="Yalnız gölgeli yüzey"/>
                            <Button Style="{StaticResource HeadButton}" Content="Tel" Click="Wireframe_Click" ToolTip="Tel kafes"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Seçim:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <Button Style="{StaticResource HeadButton}" Content="Yüz" Click="FaceSelection_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Kenar" Click="EdgeSelection_Click"/>
                            <Button Style="{StaticResource HeadButton}" Content="Köşe" Click="VertexSelection_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#EAF2F8">
                    <wfi:WindowsFormsHost x:Name="ViewportHost"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="#F9FBFC" BorderBrush="#C7D0D8" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="SrcCad hazır" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="mm" VerticalAlignment="Center" Foreground="#51606C"/>
            </Grid>
        </Border>
    </Grid>
</Window>

