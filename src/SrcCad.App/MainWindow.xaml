<Window x:Class="SrcCad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="SrcCad — Parametrik CAD"
        Width="1450" Height="900"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#EAF1F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- SrcCad identity; no third-party trademark/icon usage -->
        <Border Grid.Row="0" Background="#1D2731">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/SrcCadLogo.png" Width="44" Height="44" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SrcCad" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Parametrik CAD • OCCT B-Rep" FontSize="11" Foreground="#B8C6D2"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" Background="#263541" CornerRadius="12" Padding="12,4">
                    <TextBlock Text="PARAMETRİK CAD • ALPHA" Foreground="#DDE8F0" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Menu Grid.Row="1" Background="#FBFCFD" BorderBrush="#CDD5DC" BorderThickness="0,0,0,1">
            <MenuItem Header="Dosya">
                <MenuItem Header="Yeni Parça" InputGestureText="Ctrl+N" Click="NewPart_Click"/>
                <MenuItem Header="Yeni Montaj" Click="NewAssembly_Click"/>
                <Separator/>
                <MenuItem Header="Parça Aç…" InputGestureText="Ctrl+O" Click="OpenPart_Click"/>
                <MenuItem Header="Montaj Aç…" Click="OpenAssembly_Click"/>
                <MenuItem Header="Parçayı Farklı Kaydet…" InputGestureText="Ctrl+S" Click="SavePart_Click"/>
                <MenuItem Header="Montajı Kaydet…" Click="SaveAssembly_Click"/>
                <Separator/>
                <MenuItem Header="Yeni Teknik Resim" Click="NewDrawing_Click"/>
                <MenuItem Header="Teknik Resim Aç…" Click="OpenDrawing_Click"/>
                <MenuItem Header="Teknik Resmi Kaydet…" Click="SaveDrawing_Click"/>
                <Separator/>
                <MenuItem Header="Çıkış" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Düzenle">
                <MenuItem Header="Geri Al" InputGestureText="Ctrl+Z" Click="UndoActiveDocument_Click"/>
                <MenuItem Header="Yinele" InputGestureText="Ctrl+Y" Click="RedoActiveDocument_Click"/>
            </MenuItem>
            <MenuItem Header="Görünüm">
                <MenuItem Header="Ekrana Sığdır" InputGestureText="F" Click="Fit_Click"/>
                <MenuItem Header="Seçime Dik Bak" InputGestureText="Ctrl+8" Click="NormalTo_Click"/>
                <Separator/>
                <MenuItem Header="İzometrik" Click="Iso_Click"/>
                <MenuItem Header="Ön" Click="Front_Click"/>
                <MenuItem Header="Üst" Click="Top_Click"/>
                <MenuItem Header="Sağ" Click="Right_Click"/>
                <Separator/>
                <MenuItem Header="Gölgeli + Kenarlı" Click="ShadedEdges_Click"/>
                <MenuItem Header="Gölgeli" Click="Shaded_Click"/>
                <MenuItem Header="Tel Kafes" Click="Wireframe_Click"/>
            </MenuItem>
            <MenuItem Header="Araçlar">
                <MenuItem Header="Ölç" Click="InspectMeasure_Click"/>
                <MenuItem Header="Kütle / Geometri Özellikleri" Click="InspectMassProperties_Click"/>
                <MenuItem Header="Geometri Kontrolü" Click="InspectGeometry_Click"/>
                <Separator/>
                <MenuItem Header="Kesit Görünümü" Click="InspectSection_Click"/>
                <MenuItem Header="Draft Analizi" Click="InspectDraftAnalysis_Click"/>
                <MenuItem Header="Çakışma Kontrolü" Click="InspectInterference_Click"/>
                <MenuItem Header="B-Rep Karşılaştır" Click="InspectCompare_Click"/>
            </MenuItem>
            <MenuItem Header="Yardım" Click="About_Click"/>
        </Menu>

        <TabControl Grid.Row="2" x:Name="CommandTabs" Background="#F5F7F9" BorderBrush="#C8D1D9">
            <TabItem Header="UNSURLAR" x:Name="FeaturesTab">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="Çizim" Click="StartSketch_Click" x:Name="StartSketchButton" ToolTip="Düzlem veya düzlemsel yüz seçin; Çizim yeni sketch'i doğrudan o destek üzerinde açar."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Ekstrüzyon" Click="Extrude_Click" x:Name="ExtrudeButton" IsEnabled="False"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="Yeni Çizim" Click="NewProfileSketch_Click" x:Name="NewProfileSketchButton" IsEnabled="False" Visibility="Collapsed"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Ekstrüzyon Kes" Click="Cut_Click" x:Name="CutButton" IsEnabled="False" ToolTip="Bir yüz/düzlemde Çizim oluşturun; çizimden çıkınca bu komut seçili profili katıdan keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Döndürme" Click="Revolve_Click" x:Name="RevolveButton" ToolTip="Kapalı profil + tek merkez çizgisi ekseni ile gerçek OCCT döndürme oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Döndürerek Kes" Click="RevolveCut_Click" x:Name="RevolveCutButton" ToolTip="Kapalı profil + tek merkez çizgisi ekseni ile mevcut katıdan döndürerek keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Süpürme ▾" Click="CommandFamily_Click" x:Name="SweepButton">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Süpürme (Boss)" Click="SweepBoss_Click"/>
                            <MenuItem Header="Süpürerek Kes" Click="SweepCut_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Loft ▾" Click="CommandFamily_Click" x:Name="LoftButton">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Loft (Boss)" Click="LoftBoss_Click"/>
                            <MenuItem Header="Loft Kes" Click="LoftCut_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Sınır ▾" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Sınır (Boss)" Click="BoundaryBoss_Click"/>
                            <MenuItem Header="Sınır Kes" Click="BoundaryCut_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Radyus" Click="Fillet_Click" x:Name="FilletButton" ToolTip="Kenarları seçin; gerçek OCCT 3B radyus oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Pah" Click="Chamfer_Click" x:Name="ChamferButton" ToolTip="Kenarları seçin; gerçek OCCT 3B pah oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Delik" Click="Hole_Click" x:Name="HoleButton" ToolTip="Düzlemsel yüz seçin; tıklanan konumda gerçek parametrik delik oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Delik Sihirbazı" Click="HoleWizard_Click" x:Name="HoleWizardButton" ToolTip="Basit, havşalı veya silindirik havşalı gerçek parametrik delik oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kubbe" Click="Dome_Click" x:Name="DomeButton" ToolTip="Seçili düzlemsel yüze gerçek küresel kubbe/çökertme uygular."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kabuk" Click="Shell_Click" x:Name="ShellButton" ToolTip="Açılacak yüzleri seçin; kalınlıkla gerçek içi boş katı oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Draft" Click="Draft_Click" x:Name="DraftButton" ToolTip="Seçili yüzlere, aktif referans düzlemine göre gerçek parametrik draft açısı uygular."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Nervür" Click="Rib_Click" x:Name="RibButton" ToolTip="Katıdan sonra oluşturulan açık çizgi sketch'ini kalınlaştırıp gerçek B-Rep nervür olarak birleştirir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="LinearPattern_Click" x:Name="LinearPatternButton" ToolTip="Seçili düzlem/yüzün X yönünde parametrik gövde dizilimi oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="CircularPattern_Click" x:Name="CircularPatternButton" ToolTip="Seçili düzlem/yüzün normal ekseni etrafında parametrik gövde dizilimi oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizim Güdümlü Dizilim" Click="SketchPattern_Click" ToolTip="Bir sketch'teki noktaları gerçek 3B gövde kopya konumları olarak kullanır."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Aynala" Click="Mirror_Click" x:Name="MirrorButton" ToolTip="Düzlemsel yüz veya Ön/Üst/Sağ Düzlem seçin; katıyı gerçek 3B ayna dönüşümüyle çoğaltır."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Gövde İşlemleri ▾" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Birleştir / Çıkar / Ortak" Click="BodyBoolean_Click"/>
                            <MenuItem Header="Gövdeyi Taşı / Kopyala" Click="MoveCopyBody_Click"/>
                            <MenuItem Header="Gövdeyi Böl" Click="SplitBody_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Referans Geometri ▾" Click="CommandFamily_Click" x:Name="ReferenceGeometryButton">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Düzlem (Ofset)" Click="ReferencePlane_Click"/>
                            <MenuItem Header="Eksen" Click="ReferenceAxis_Click"/>
                            <MenuItem Header="Nokta" Click="ReferencePoint_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CommandButton}" Content="Yeni Parça" Click="NewPart_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="ÇİZİM" x:Name="SketchTab">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Seç (Esc)" Tag="{StaticResource CadSelectIcon}" Click="SelectTool_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizgi ▾" Tag="{StaticResource CadLineIcon}" Click="CommandFamily_Click" x:Name="LineButton">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Çizgi" Click="Line_Click"/>
                            <MenuItem Header="Merkez Çizgisi" Click="Centerline_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dikdörtgen ▾" Tag="{StaticResource CadRectangleIcon}" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Köşe Dikdörtgen" Click="CornerRectangle_Click"/>
                            <MenuItem Header="Merkez Dikdörtgen" Click="CenterRectangle_Click"/>
                            <MenuItem Header="3 Noktalı Köşe Dikdörtgen" Click="ThreePointRectangle_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CadCommandButton}" Content="Daire ▾" Tag="{StaticResource CadCircleIcon}" Click="CommandFamily_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Merkez-Yarıçap Dairesi" Click="Circle_Click"/>
                            <MenuItem Header="3 Nokta Dairesi" Click="ThreePointCircle_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Yay" Click="Arc_Click" ToolTip="Merkez, başlangıç ve bitiş yönüyle gerçek parametrik yay oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Slot" Click="Slot_Click" ToolTip="İki merkez noktası ve genişlikle gerçek çizgi+yay kapalı slot oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çokgen" Click="Polygon_Click" ToolTip="Kenar sayısını girin; merkez ve çevre noktasıyla düzenli çokgen oluşturun."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Elips" Click="Ellipse_Click" ToolTip="Merkez, ana eksen ve ikinci eksen ile gerçek parametrik elips oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizim Radyusu" Click="SketchFillet_Click" ToolTip="Ortak köşeli iki çizgiyi seçin; gerçek teğet yay radyusu oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizim Pahı" Click="SketchChamfer_Click" ToolTip="Ortak köşeli iki çizgiyi seçin; iki çizgiyi kırpıp gerçek pah çizgisi oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizgi Kırp" Tag="{StaticResource CadTrimIcon}" Click="Trim_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Uzat" Click="ExtendSketch_Click" ToolTip="Seçili çizgileri en yakın çizgi/daire sınırına kadar uzatır."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Ofset" Click="OffsetSketch_Click" ToolTip="Seçili çizgi/daireleri girilen mesafede gerçek geometri olarak ofsetler."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Aynala" Click="MirrorSketch_Click" ToolTip="Seçili geometri + Merkez Çizgisi ile parametrik çizim kopyası oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="LinearSketchPattern_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="CircularSketchPattern_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Akıllı Ölçü" Click="SmartDimension_Click" x:Name="SmartDimensionButton"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadRelationIcon}" Content="İlişkiler" Click="ShowSketchRelations_Click"/>
                    <Separator Margin="8,2"/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExitSketchIcon}" Content="Çizimden Çık" Click="ExitSketch_Click" x:Name="ExitSketchButton"/>
                    <Button x:Name="CancelSourceSketchEditButton" Style="{StaticResource CommandButton}" Content="Düzenlemeyi&#x0a;İptal Et" Click="CancelSourceSketchEdit_Click" Visibility="Collapsed"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="SAC LEVHA">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Taban Flanş" Click="BaseFlange_Click" x:Name="BaseFlangeButton" ToolTip="Kapalı çizimden gerçek sac gövdesi oluşturur; kalınlık, büküm yarıçapı ve K-faktörü parametriktir."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Kenar Flanşı" Click="EdgeFlange_Click" x:Name="EdgeFlangeButton" ToolTip="Sacın doğrusal kenarlarını seçin; uzunluk, açı, kalınlık ve büküm yarıçapıyla gerçek flanş oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Gönye Flanşı" Click="MiterFlange_Click" ToolTip="En az iki bağlı sac kenarı seçin; aynı feature içinde çoklu gerçek flanş B-Rep'i oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadCutIcon}" Content="Sac Kes" Click="SheetCut_Click" x:Name="SheetCutButton" ToolTip="Sac yüzünde oluşturulan kapalı çizimi gerçek Through-All kesme olarak uygular."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Hem" Click="Hem_Click" ToolTip="Sac kenarını seçin; gerçek geri-kıvrılmış hem B-Rep oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Jog" Click="Jog_Click" ToolTip="Sac kenarını seçin; yükseklik ve ofsetle gerçek Z-step jog oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çizilmiş Büküm" Click="SketchedBend_Click" ToolTip="Tek çizgili sketch'i büküm ekseni olarak kullanıp gerçek sac bükümü oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Açınım" Click="Unfold_Click" ToolTip="Son parametrik çizilmiş bükümü ters açıyla açar."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Katla" Click="Fold_Click" ToolTip="Son açınım işlemini yeniden katlar."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Yırtık" Click="Rip_Click" ToolTip="Seçili sac kenarı boyunca parametrik boşluk keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Köşe Rölyefi" Click="CornerRelief_Click" ToolTip="Seçili kenar uçlarında gerçek dairesel köşe rahatlatması keser."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Sac'a Dönüştür" Click="ConvertToSheetMetal_Click" x:Name="ConvertToSheetMetalButton" ToolTip="Mevcut katıya sac kalınlığı, büküm yarıçapı ve K-faktörü meta verisini parametrik feature olarak bağlar."/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="PROFİLLER">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadSketchIcon}" Content="3B Çizim" Click="SpatialSketch_Click" ToolTip="Dünya koordinatlarında parametrik 3B yol noktaları oluşturur; Sweep ve Yapısal Eleman yolunda kullanılabilir."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadExtrudeIcon}" Content="Yapısal Eleman" Click="StructuralMember_Click" ToolTip="Kapalı profil çizimini yol çizimi boyunca gerçek OCCT katısı olarak oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadTrimIcon}" Content="Kırp / Uzat" Click="StructuralTrim_Click" ToolTip="Aktif/Seçili düzlemle yapısal gövdeyi gerçek OCCT yarım-uzay işlemiyle kırpar; korunacak taraf değiştirilebilir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Köşebent" Click="Gusset_Click" ToolTip="Açık çizimden gerçek OCCT nervür/gusset katısı oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Uç Kapağı" Click="EndCap_Click" x:Name="EndCapButton" ToolTip="Düzlemsel uç yüzünü seçin; gerçek OCCT B-Rep uç kapağı ekler."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kaynak Dikişi" Click="WeldBead_Click" x:Name="WeldBeadButton" ToolTip="Seçili kenarlar boyunca gerçek OCCT süpürme kaynak dikişi katısı oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesim Listesi" Click="StructuralCutList_Click" ToolTip="Yapısal Eleman feature'larından gerçek boy/kesit alanı/hacim listesi üretir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Profil Kütüphanesi" Click="ProfileLibrary_Click" ToolTip="Ölçülü dikdörtgen veya dairesel profil sketch'i üretir; Yapısal Eleman için kullanılabilir."/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="MONTAJ">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Yeni Montaj" Click="NewAssembly_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Bileşen Ekle" Click="AddAssemblyComponent_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Montaj İlişkisi" Click="AssemblyMate_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Taşı / Döndür" Click="AssemblyMove_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Patlatılmış Görünüm" Click="AssemblyExplode_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Normal Görünüm" Click="AssemblyResetView_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Doğrusal Dizilim" Click="AssemblyLinearPattern_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Dairesel Dizilim" Click="AssemblyCircularPattern_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Bileşen Aynala" Click="AssemblyMirror_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çakışma Kontrolü" Click="AssemblyInterference_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="TEKNİK RESİM">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Content="Model Görünümü" Click="DrawingModelView_Click" ToolTip=".scpart modelinden gerçek OCCT kenar izdüşümü oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="İzdüşüm" Click="DrawingProjectedView_Click" ToolTip="Seçili görünüşten bağlı Üst/Sağ görünüş üretir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesit" Click="DrawingSectionView_Click" ToolTip="Seçili görünüşten model merkezinden geçen gerçek OCCT kesit eğrileri üretir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Detay" Click="DrawingDetailView_Click" ToolTip="Seçili görünüşten 2× detay görünüşü oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kopuk Görünüm" Click="DrawingBrokenView_Click" ToolTip="Seçili görünüşün orta bölgesini kaldırıp kalıcı kopuk görünüm oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Akıllı Ölçü" Click="DrawingSmartDimension_Click" ToolTip="Seçili görünüşün gerçek izdüşüm sınırlarından genel X×Y ölçüsü üretir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Delik Çağrısı" Click="DrawingHoleCallout_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Merkez İşareti" Click="DrawingCenterMark_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Not" Click="DrawingAddNote_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Malzeme Listesi" Click="DrawingBom_Click" ToolTip=".scasm görünüşünden gerçek bileşen adetleriyle BOM oluşturur."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Balon" Click="DrawingBalloon_Click"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="ÖLÇÜM / İNCELEME">
                <WrapPanel Margin="8">
                    <Button Style="{StaticResource CadCommandButton}" Tag="{StaticResource CadDimensionIcon}" Content="Ölç" Click="InspectMeasure_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kütle Özellikleri" Click="InspectMassProperties_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Kesit Görünümü" Click="InspectSectionView_Click" ToolTip="Aktif düzlem yönünde model merkezinden gerçek OCCT kesit eğrilerini gösterir."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Geometri Kontrolü" Click="InspectGeometry_Click"/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Draft Analizi" Click="InspectDraftAnalysis_Click" ToolTip="Seçili yüzlerin aktif çekme yönüne göre gerçek draft açısını hesaplar."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Çakışma" Click="InspectInterference_Click" ToolTip="İki .scpart B-Rep arasındaki gerçek ortak hacmi OCCT ile hesaplar."/>
                    <Button Style="{StaticResource CadCommandButton}" Content="Karşılaştır" Click="InspectCompare_Click" ToolTip="İki modelin hacim ve topoloji özetini karşılaştırır."/>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="ManagerTabs" BorderBrush="#BAC5CE" Background="#F8FAFB">
                <TabItem Header="FeatureManager" x:Name="FeatureManagerTab">
                    <TreeView x:Name="FeatureTree" BorderThickness="0" Background="#FAFBFC"
                              SelectedItemChanged="FeatureTree_SelectedItemChanged" MouseDoubleClick="FeatureTree_MouseDoubleClick">
                        <TreeViewItem Header="Parça1" x:Name="PartNode" IsExpanded="True">
                            <TreeViewItem Header="Geçmiş"/>
                            <TreeViewItem Header="Sensörler"/>
                            <TreeViewItem Header="Detaylandırmalar"/>
                            <TreeViewItem Header="Malzeme &lt;belirli değil&gt;"/>
                            <TreeViewItem Header="Orijin" x:Name="OriginNode" IsExpanded="True">
                                <TreeViewItem Header="Ön Düzlem" Tag="plane:front" x:Name="FrontPlaneNode"/>
